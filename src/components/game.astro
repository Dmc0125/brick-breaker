<div class="w-full">
    <div class="w-full max-w-[800px] mx-auto flex justify-between items-start">
        <div>
            <p class="font-medium text-gray-400">Score</p>
            <p id="score-text" class="text-gray-200 text-lg">0</p>
        </div>
        <div class="flex flex-col items-end gap-2">
            <p class="font-medium text-gray-400">Boost</p>
            <div id="boost-indicator" class="w-20 h-2 rounded-full bg-gray-500/20 relative">
                <div
                    id="boost-indicator-bar"
                    class="absolute left-0 top-0 bottom-0 w-0 bg-gray-500 rounded-full"
                >
                </div>
            </div>
        </div>
    </div>

    <div class="w-full max-w-[800px] mx-auto mt-4 aspect-[4/3] relative">
        <canvas
            id="canvas"
            class="w-full max-w-[800px] mx-auto mt-4 aspect-[4/3] rounded border border-cyan-500"
        ></canvas>
        <div class="absolute inset-0 flex justify-center items-center">
            <p id="announcer-text" class="text-white text-2xl hidden">Streak x4</p>
        </div>
        <div
            id="start-screen"
            class="absolute inset-0 flex flex-col justify-center items-center gap-4"
        >
            <h1 class="text-4xl text-cyan-200 font-semibold">Brick breaker</h1>
            <button
                id="start-button"
                class="px-4 py-2 rounded-md bg-cyan-500 text-white font-semibold text-xl shadow-cyan-500/50 shadow-lg"
                >Start</button
            >
        </div>
        <div
            id="pause-screen"
            class="hidden absolute inset-0 flex flex-col justify-center items-center gap-4 bg-black/20"
            style="backdrop-filter: blur(5px)"
        >
            <h1 class="text-4xl text-cyan-200 font-semibold">Paused</h1>
            <button
                id="resume-button"
                class="px-4 py-2 rounded-md bg-cyan-500 text-white font-semibold text-xl shadow-cyan-500/50 shadow-lg"
                >Resume</button
            >
        </div>
        <div
            id="gameover-screen"
            class="hidden absolute inset-0 flex flex-col justify-center items-center gap-4 bg-black/20"
            style="backdrop-filter: blur(5px)"
        >
            <h1 class="text-4xl text-cyan-200 font-semibold">Game over</h1>
            <div class="flex gap-2">
                <span class="text-gray-400">Score:</span>
                <span id="gameover-score-text" class="text-gray-200">0</span>
            </div>
            <button
                id="start-again-button"
                class="px-4 py-2 rounded-md bg-cyan-500 text-white font-semibold text-xl shadow-cyan-500/50 shadow-lg"
                >Start</button
            >
        </div>
    </div>
</div>
