---
import "../styles/global.css";
---

<html class="w-full min-h-screen">
    <head>
        <title>Astro</title>
    </head>
    <body class="w-full min-h-screen px-8 mt-10 bg-black">
        <div class="w-full max-w-[800px] mx-auto flex justify-between">
            <div class="flex items-center gap-8">
                <div class="flex flex-col gap-1">
                    <p class="text-gray-400 text-sm font-medium uppercase">
                        Score
                    </p>
                    <p class="text-cyan-400">400</p>
                </div>
                <div class="flex flex-col gap-1">
                    <p class="text-gray-400 text-sm font-medium uppercase">
                        Level
                    </p>
                    <p class="text-cyan-400">1</p>
                </div>
            </div>

            <div class="flex flex-col items-end gap-1">
                <p class="text-gray-400 text-sm font-medium uppercase">Boost</p>
                <div
                    id="boost-indicator"
                    class="relative w-20 h-2 rounded-full bg-gray-500/20"
                >
                    <div
                        id="boost-indicator-inner"
                        class="absolute left-0 top-0 h-2 rounded-full bg-gray-500 w-0 transition-all"
                    >
                    </div>
                </div>
            </div>
        </div>

        <div class="relative w-full max-w-[800px] mx-auto mt-4">
            <canvas
                id="canvas"
                class="w-full max-w-[800px] aspect-[3/2] rounded border border-cyan-500"
            ></canvas>

            <div
                id="start-menu"
                class="absolute inset-0 flex flex-col items-center justify-center gap-4"
            >
                <h1 class="text-cyan-200 text-3xl font-bold">Brick breaker</h1>

                <button
                    id="start-button"
                    class="bg-cyan-500 text-white px-4 py-2 rounded font-semibold"
                >
                    Start Breaking
                </button>
            </div>

            <div
                id="countdown"
                class="hidden absolute inset-0 flex items-center justify-center text-cyan-200 text-3xl font-bold"
            >
            </div>

            <div
                id="gameover"
                class="hidden absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/10 rounded"
                style="backdrop-filter: blur(5px)"
            >
                <p class="text-red-400 text-3xl font-bold text-shadow-lg">
                    Game Over
                </p>
                <button
                    id="restart-button"
                    class="bg-cyan-500 text-white px-4 py-2 rounded font-semibold"
                >
                    Restart
                </button>
            </div>

            <div
                id="paused"
                class="hidden absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/10 rounded"
                style="backdrop-filter: blur(5px)"
            >
                <p class="text-cyan-200 text-3xl font-bold text-shadow-lg">
                    Paused
                </p>
                <button
                    id="resume-button"
                    class="bg-cyan-500 text-white px-4 py-2 rounded font-semibold"
                >
                    Resume
                </button>
            </div>
        </div>
    </body>
</html>

<script src="../js/index.ts"></script>
